# ── UU Student Hub ────────────────────────────────────────────────────────────
# Copy this file to `.env` and adjust the values for your environment.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# SQLite database location (defaults to ./data/app.db).
# DATABASE_PATH=./data/app.db

# Comma-separated list of browser origins allowed to call the API.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session lifetime for access tokens (any of: 45s, 30m, 12h, 7d).
# JWT_EXPIRES_IN=7d

# Signing key for access tokens. If omitted, a random secret is generated once
# and persisted to ./data/.jwt-secret — set it explicitly for deployments.
# JWT_SECRET=

# Rate limiting.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=25

# Set to `false` to skip seeding the demo student on first boot.
# SEED_DEMO_DATA=false

# ── AI Study Assistant ────────────────────────────────────────────────────────
# The API key stays on the server — it is never sent to the browser.
# provider: `mock` (built-in responder, no key needed) or `openai`.
AI_PROVIDER=mock
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Point the SPA at this backend. Leave unset to run fully offline in localStorage.
VITE_API_URL=http://localhost:3000/api
# Optional override for the chat endpoint (defaults to `${VITE_API_URL}/chat`).
# VITE_AI_API_URL=http://localhost:3000/api/chat
